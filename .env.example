# Meilisearch Configuration
# Host URL of the Meilisearch instance
VITE_MEILISEARCH_HOST=http://localhost:7700
# Public search key (read-only, exposed to frontend)
VITE_MEILISEARCH_SEARCH_KEY=
# Admin key (write access, used for indexing only, NOT exposed to frontend)
MEILISEARCH_ADMIN_KEY=
# Index name (shared between frontend and indexing script)
VITE_MEILISEARCH_INDEX_NAME=docs
