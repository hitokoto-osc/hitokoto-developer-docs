{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc/json-schemas/main/oxlintrc.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-debugger": "error",
    "import/no-unassigned-import": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "docs/.vitepress/cache"]
}
