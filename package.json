{
  "name": "hitokoto-developer-docs",
  "version": "1.0.0",
  "description": "Hitokoto developer docs.",
  "main": "index.js",
  "repository": "https://source.hitokoto.cn/hitokoto/hitokoto-developer-docs.git",
  "author": "a632079 <a632079@qq.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "precommit": "lint-staged",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:index": "node --env-file=.env scripts/meilisearch-index.mjs",
    "docs:deploy-local": "pnpm docs:build && pnpm docs:index",
    "docs:serve": "vitepress serve docs",
    "postinstall": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@iconify/json": "^2.2.461",
    "@tailwindcss/vite": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^4.0.0",
    "@types/workbox-build": "^5.1.0",
    "@vite-pwa/vitepress": "^1.1.0",
    "@vue/babel-preset-app": "^5.0.9",
    "@vueuse/core": "^14.2.1",
    "husky": "^9.1.7",
    "lodash-es": "^4.18.1",
    "markdown-it-container": "^4.0.0",
    "meilisearch": "^0.57.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vue-tsc": "^3.2.6",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-plugin-google-analytics": "^1.0.2",
    "vitepress-plugin-nprogress": "^0.1.1",
    "vue": "^3.5.32"
  },
  "dependencies": {
    "sass": "^1.99.0"
  }
}
